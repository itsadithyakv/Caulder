{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "electron/main/index.ts",
    "electron/preload/index.ts",
    "src/main.tsx",
    "src/theme-boot.ts",
    "electron.vite.config.ts",
    "e2e/**/*.spec.ts"
  ],
  "project": ["electron/**/*.ts", "src/**/*.{ts,tsx}", "shared/**/*.ts", "e2e/**/*.ts"],
  // Ambient declarations. Nothing imports them - that is what ambient means -
  // so they read as unused to any reachability analysis.
  "ignore": [
    "src/global.d.ts",
    "e2e/bridge.d.ts"
  ]
}
